<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Bookstore Login</title>

    <style>
            body {
                font-family: Arial;
                margin: 50px;
            }

            .login {
                width: 350px;
            }

            input {
                width: 100%;
                padding: 8px;
                margin: 5px 0 15px;
            }

            button {
                padding: 10px 20px;
            }

            .error {
                color: red;
            }
    </style>
</head>

<body>

    <div class="login">

        <h2>Bookstore Login</h2>

        @if (ViewBag.Error != null)
        {
            <p class="error">
                @ViewBag.Error
            </p>
        }

        <form method="post"
              action="/Account/Login">

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewBag.ReturnUrl" />

            <label>
                Username
            </label>

            <input type="text"
                   name="username"
                   value="testuser" />

            <label>
                Password
            </label>

            <input type="password"
                   name="password"
                   value="password" />

            <button type="submit">
                Login
            </button>

        </form>

    </div>

</body>
</html>